rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the requester an admin/mentor/coach?
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/brothers/$(request.auth.uid)) == false &&
        // Fall back to email-matched doc role check
        (
          // Try matching by any brothers doc where email matches
          true // Admins are gated in the app; Firestore allows all auth'd writes below
        );
    }

    // ── Brothers collection ────────────────────────────────────────
    match /brothers/{brotherId} {

      // Any authenticated user can read all brothers (needed for the grid)
      allow read: if request.auth != null;

      // Admins (role field = admin/mentor/coach) can write anything
      allow write: if request.auth != null &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/brothers/$(brotherId)) &&
        get(/databases/$(database)/documents/brothers/$(brotherId)).data.get('role','member') in ['admin','mentor','coach'];

      // Members can update their own document — identified by matching email
      allow update: if request.auth != null &&
        resource.data.email == request.auth.token.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          // Daily challenge
          'dailyChallenge',
          'dailyChallengeCompletedDate',
          // XP & level
          'xp',
          // Path progress
          'pathProgress',
          'archetypeStages',
          'unlockedArchetypes',
          'earnedBadges',
          'currentPathArchetype',
          // Check-in & streak
          'lastCheckInDate',
          'brotherhoodScore',
          'weeklyWin',
          'weeklyChallenge',
          'weeklyCommitment',
          'momentum',
          'currentStreak',
          'longestStreak',
          // Assessment
          'primaryArchetype',
          'growthArchetype',
          'dominantElement',
          'growthElement',
          'archetypeScores',
          'elementScores',
          'assessmentCompletedAt',
          // Presence & notifications
          'lastSeen',
          'fcmToken',
        ]);
    }

    // ── Challenges (admin-created) ─────────────────────────────────
    match /challenges/{chalId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;   // app-level gating handles admin check
    }

    // ── Submissions ────────────────────────────────────────────────
    match /submissions/{subId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ── Social feed ────────────────────────────────────────────────
    match /feed/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ── DMs ────────────────────────────────────────────────────────
    match /dms/{convoId}/messages/{msgId} {
      allow read, write: if request.auth != null;
    }

    match /dms/{convoId} {
      allow read, write: if request.auth != null;
    }
  }
}
